# --- Server (Express) ---
PORT=4000
# Public site URL (used for CORS allow-list; comma-separate multiple origins).
# Not needed when the site and API are served by the same Express process (Render default).
CLIENT_ORIGIN=http://localhost:5173
# Contact delivery via Resend (https://resend.com). Without these the API answers 503
# instead of pretending a message was stored.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Must be an address on a domain verified in Resend (onboarding@resend.dev works for testing to your own account email).
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Frontend build (optional) ---
# Only set if the API runs on a different origin than the site.
VITE_API_URL=
